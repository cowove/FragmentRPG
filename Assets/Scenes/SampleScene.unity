MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 601564408}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a88d6a71b8e690445bed6d1ced1e03e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FragmentRPG.InteractableObject
  objectId: NPC_SHOP_EP1
  displayName: "Ep.1 \uC758\uB8B0\uC778: \uC2DC\uACC4\uACF5 \uB178\uC778"
  interactionType: 0
  canInteract: 1
  dialogId: DLG_NPC_SHOP_EP1
  fallbackDialogLines:
  - "\"\uC218\uB9AC\uACF5 \uC591\uBC18, \uC774 \uD68C\uC911\uC2DC\uACC4\uAC00 11\uC2DC
    55\uBD84\uC5D0\uC11C \uB3C4\uD1B5 \uC6C0\uC9C1\uC774\uC9C8 \uC54A\uB124.\""
  - "\"\uADF8\uB0A0 \uC544\uCE68 9\uC2DC\uC5D0 \uB0B4\uAC00 \uC2DC\uACC4\uD0D1 \uBB38\uC744
    \uC5F4\uACE0, \uC815\uC624(12:00)\uC5D0 \uC2DC\uACC4\uD0D1 \uC885\uC744 \uC815\uC0C1\uC801\uC73C\uB85C
    \uC6B8\uB9B0 \uB4A4\uC5D0 \uB538\uC744 \uBC30\uC6C5\uD558\uB7EC \uAC14\uB294\uB370
    \uB9D0\uC774\uC57C...\""
  - "\"\uBC14\uB85C \uC606 \uC791\uC5C5\uB300\uC758 [\uBA48\uCD98 \uD68C\uC911\uC2DC\uACC4]\uB97C
    \uC870\uC0AC\uD574 \uB0B4 \uAE30\uC5B5 \uACF5\uAC04(\uC2DC\uACC4\uD0D1 \uB300\uAD11\uC7A5)\uC744
    \uC218\uB9AC\uD574 \uC8FC\uAC8C!\""
  clearedDialogLines:
  - "\"\uC624\uC624! 11\uC2DC 55\uBD84\uC5D0 \uBA48\uCDB0 \uC788\uB358 \uD68C\uC911\uC2DC\uACC4
    \uBC14\uB298\uC774 \uB2E4\uC2DC \uD798\uCC28\uAC8C \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5B4!\""
  - "\"\uB5A0\uB098\uB294 \uB538\uC758 \uAE30\uCC28\uB97C \uBD99\uC7A1\uACE0 \uC2F6\uC5B4\uC11C
    11\uC2DC 55\uBD84\uC5D0 \uB0B4 \uC190\uC73C\uB85C \uD0DC\uC5FD\uC744 \uBA48\uCDC4\uB358
    \uAC70\uC600\uC9C0... \uACE0\uB9D9\uB124, \uC218\uB9AC\uACF5 \uC591\uBC18!\""
  clueId: FRAG_01
  clueTitle: "\uAE30\uC5B5\uC870\uAC01 1"
  clueDescription: "\uBE44\uC5B4\uC9C4 \uBC30\uACBD\uC758 \uC67C\uCABD \uACF5\uAC04\uC744
    \uCC44\uC6B8 \uC218 \uC788\uB294 \uCCAB \uBC88\uC9F8 \uAE30\uC5B5\uC870\uAC01."
  deactivateOnCollect: 1
  slotId: SLOT_BG_01
  requiredClueId: FRAG_01
  isSlotFilled: 0
  emptySlotSprite: {fileID: 0}
  restoredSlotSprite: {fileID: 0}
  filledBackgroundColor: {r: 1, g: 1, b: 1, a: 1}
  restoredVisualChild: {fileID: 0}
  puzzleId: PUZ_EP1_FINAL
  puzzleType: 0
  targetSpaceId: SPACE_MEMORY_MAP
