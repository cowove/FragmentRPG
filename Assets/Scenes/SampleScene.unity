  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a88d6a71b8e690445bed6d1ced1e03e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FragmentRPG.InteractableObject
  objectId: NPC_SHOP_EP2
  displayName: "Ep.2 \uC758\uB8B0\uC778: \uBB34\uBA85 \uD654\uAC00"
  interactionType: 0
  canInteract: 1
  dialogId: DLG_NPC_SHOP_EP2
  fallbackDialogLines:
  - "\"\uC81C \uB9C8\uC9C0\uB9C9 \uC790\uD654\uC0C1 \uCE94\uBC84\uC2A4\uAC00 \uD558\uC597\uAC8C
    \uC9C0\uC6CC\uC838 \uBC84\uB838\uC5B4\uC694.\""
  - "\"\uD3ED\uD48D\uC6B0 \uCE58\uB358 \uBC24 \uB0B4\uB0B4 \uD654\uC2E4 \uCC3D\uBB38\uC744
    \uAD73\uAC8C \uB2EB\uC544\uB450\uC5B4\uC11C \uBE57\uBB3C\uC774 \uB4E4\uC5B4\uC62C
    \uB9AC \uC5C6\uC5C8\uB294\uB370 \uC65C \uBB3C\uAC10\uC774 \uBC88\uC84C\uC744\uAE4C\uC694?\""
  - "\"\uC606 \uC791\uC5C5\uB300\uC758 [\uC9C0\uC6CC\uC9C4 \uCE94\uBC84\uC2A4]\uB97C
    \uD1B5\uD574 \uC81C \uAE30\uC5B5 \uACF5\uAC04(\uB2EC\uBE5B \uD654\uC2E4 \uC815\uC6D0)\uC73C\uB85C
    \uB4E4\uC5B4\uAC00 \uC9C4\uC2E4\uC744 \uCC3E\uC544\uC8FC\uC138\uC694!\""
  clearedDialogLines:
  - "\"\uB9DE\uC544\uC694... \uD3ED\uD48D\uC6B0 \uC18D \uB2EC\uBE5B\uC744 \uB2F4\uC73C\uB824\uACE0
    \uC81C\uAC00 \uC9C1\uC811 \uCC3D\uBB38\uC744 \uD65C\uC9DD \uC5F4\uC5B4\uC816\uD614\uC5C8\uC8E0!\""
  - "\"\uB355\uBD84\uC5D0 \uC9C0\uC6CC\uC84C\uB358 \uC790\uD654\uC0C1\uC758 \uC0C9\uCC44\uAC00
    \uC628\uC804\uD788 \uB3CC\uC544\uC654\uC5B4\uC694. \uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4!\""
  clueId: FRAG_01
  clueTitle: "\uAE30\uC5B5\uC870\uAC01 1"
  clueDescription: "\uBE44\uC5B4\uC9C4 \uBC30\uACBD\uC758 \uC67C\uCABD \uACF5\uAC04\uC744
    \uCC44\uC6B8 \uC218 \uC788\uB294 \uCCAB \uBC88\uC9F8 \uAE30\uC5B5\uC870\uAC01."
