  restoredSlotSprite: {fileID: 0}
  filledBackgroundColor: {r: 1, g: 1, b: 1, a: 1}
  restoredVisualChild: {fileID: 0}
  puzzleId: PUZ_EP1_FINAL
  puzzleType: 0
  targetSpaceId: SPACE_MEMORY_MAP
