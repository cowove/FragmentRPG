  objectId: NPC_SHOP_EP3
  displayName: "Ep.3 \uC778\uB3C4\uC790: \uAE30\uC5B5\uC758 \uC794\uD5A5"
  interactionType: 0
  canInteract: 1
  dialogId: DLG_NPC_SHOP_EP3
  fallbackDialogLines:
  - "\"\uD0C0\uC778\uC758 \uBD80\uC11C\uC9C4 \uAE30\uC5B5\uC744 \uACE0\uCE58\uBA70
    \uB124\uAC00 \uCC3E\uC544 \uD5E4\uB9E8 \uAC74, \uACB0\uAD6D \uB108 \uC790\uC2E0\uC774
    \uBD09\uC778\uD574 \uB450\uC5C8\uB358 \uAE30\uC5B5\uC774\uB2E4.\""
  - "\"\uB10C \uC2A4\uC2A4\uB85C\uB97C '\uC774\uB984\uB3C4 \uACFC\uAC70\uB3C4 \uC5C6\uB358
    \uBE48 \uAECD\uB370\uAE30'\uB77C\uACE0 \uBBFF\uACE0 \uC788\uC9C0\uB9CC, \uADF8\uAC74
    \uB124\uAC00 \uB9CC\uB4E0 \uAC70\uC9D3 \uAE30\uC5B5\uC774\uC57C.\""
  - "\"\uC624\uB978\uCABD \uC791\uC5C5\uB300\uC758 [\uBD09\uC778\uB41C \uD0DC\uC5FD
    \uCF54\uC5B4]\uB97C \uC870\uC0AC\uD574 \uB108 \uC790\uC2E0\uC758 \uAE30\uC5B5
    \uC131\uC18C\uB85C \uB4E4\uC5B4\uAC00\uB77C.\""
  clearedDialogLines:
  - "\"\uBAA8\uB4E0 \uAE30\uC5B5 \uC870\uAC01\uC774 \uD558\uB098\uB85C \uC774\uC5B4\uC84C\uB2E4.
    \uC774\uC81C \uB108\uB294 \uAE30\uC5B5 \uC218\uB9AC\uC810\uC758 \uC9C4\uC9DC
    \uC8FC\uC778\uC73C\uB85C \uAE68\uC5B4\uB0AC\uB2E4!\""
  clueId: FRAG_01
  clueTitle: "\uAE30\uC5B5\uC870\uAC01 1"
  clueDescription: "\uBE44\uC5B4\uC9C4 \uBC30\uACBD\uC758 \uC67C\uCABD \uACF5\uAC04\uC744
    \uCC44\uC6B8 \uC218 \uC788\uB294 \uCCAB \uBC88\uC9F8 \uAE30\uC5B5\uC870\uAC01."
